<Application x:Class="Wincy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Wincy.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <views:BoolToVisibilityConverter x:Key="BoolToVisibilityInverted" Invert="True" />
            <views:BoolToVisibilityConverter x:Key="BoolToHidden" UseHidden="True" />
            <views:NullToVisibilityConverter x:Key="NullToVisibility" />
            <views:NullToVisibilityConverter x:Key="NullToVisibilityInverted" Invert="True" />
            <views:SelectionBrushConverter x:Key="SelectionBrush" />
            <views:SelectionForegroundConverter x:Key="SelectionForeground" />
            <views:ColorToBrushConverter x:Key="ColorToBrush" />
            <views:EnumEqualsConverter x:Key="EnumEquals" />
            <views:ByteSizeConverter x:Key="ByteSize" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
