<Window x:Class="Wincy.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Wincy"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontSize="13">

    <StackPanel Margin="28,24,28,22">
        <Border Width="64" Height="64" CornerRadius="14" HorizontalAlignment="Center"
                Background="{DynamicResource AccentBrush}">
            <Path x:Name="Mark" Width="34" Height="34" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Fill="{DynamicResource AccentTextBrush}" />
        </Border>

        <TextBlock Text="Wincy" FontSize="22" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,14,0,0" />

        <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,4,0,0"
                   Style="{StaticResource SecondaryText}" />

        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Clipboard history for Windows: lightweight, keyboard-first, and entirely local." />

        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"
                   Style="{StaticResource SecondaryText}" FontSize="11.5"
                   Text="A Windows port of Maccy, the macOS clipboard manager by Alex Rodionov. Wincy shares its behaviour and layout but none of its code — it is written from scratch in C# on WPF and Win32." />

        <Border Style="{StaticResource RowSeparator}" Margin="0,18,0,14" />

        <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryText}" FontSize="11.5"
                   Text="Your clipboard history never leaves this computer." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Content="Open the data folder" Style="{StaticResource DialogButton}"
                    Click="OnOpenDataFolder" />
            <Button Content="Close" Margin="8,0,0,0" Style="{StaticResource PrimaryDialogButton}"
                    Click="OnClose" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
