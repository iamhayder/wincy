<Window x:Class="Wincy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Wincy.Views.Controls"
        Title="Wincy Preferences"
        Width="620" Height="640"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" CornerRadius="5" Margin="2,0"
                                Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- A settings row: right-aligned label, control on the right. -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,5" />
        </Style>
    </Window.Resources>

    <TabControl Margin="12">
        <!-- ============================================================ GENERAL -->
        <TabItem Header="General">
            <ScrollViewer Padding="14,10,14,14">
                <StackPanel>
                    <TextBlock Text="Startup" Style="{StaticResource SectionHeading}" Margin="0,4,0,8" />
                    <CheckBox Content="Launch Wincy at login"
                              IsChecked="{Binding Settings.LaunchAtLogin, Mode=TwoWay}" />

                    <TextBlock Text="Shortcuts" Style="{StaticResource SectionHeading}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Open Wincy" Style="{StaticResource SettingsLabel}" />
                        <controls:HotKeyBox Grid.Column="1" HorizontalAlignment="Left"
                                            HotKey="{Binding Settings.PopupHotKey, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pin or unpin" Style="{StaticResource SettingsLabel}" />
                        <controls:HotKeyBox Grid.Column="1" HorizontalAlignment="Left"
                                            HotKey="{Binding Settings.PinHotKey, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Delete item" Style="{StaticResource SettingsLabel}" />
                        <controls:HotKeyBox Grid.Column="1" HorizontalAlignment="Left"
                                            HotKey="{Binding Settings.DeleteHotKey, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Toggle preview" Style="{StaticResource SettingsLabel}" />
                        <controls:HotKeyBox Grid.Column="1" HorizontalAlignment="Left"
                                            HotKey="{Binding Settings.PreviewHotKey, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsHelp}" Margin="160,2,0,0"
                               Text="Only the &quot;Open Wincy&quot; shortcut is registered system-wide. The others work while the popup is open." />

                    <TextBlock Text="Search" Style="{StaticResource SectionHeading}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Match using" Style="{StaticResource SettingsLabel}" />
                        <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding SearchModes}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.SearchMode, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Text="Behaviour" Style="{StaticResource SectionHeading}" />
                    <CheckBox Content="Paste automatically when an item is chosen"
                              IsChecked="{Binding Settings.PasteByDefault, Mode=TwoWay}" />
                    <CheckBox Content="Paste without formatting"
                              IsChecked="{Binding Settings.RemoveFormattingByDefault, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource SettingsHelp}"
                               Text="These two settings decide what plain Enter does, and which modifiers select the other actions. The badge on each row always shows what the current modifiers will do." />

                    <TextBlock Text="Notifications and sounds" Style="{StaticResource SectionHeading}" />
                    <CheckBox Content="Play a sound on copy" IsChecked="{Binding Settings.PlaySounds, Mode=TwoWay}" />
                    <CheckBox Content="Show a notification on copy"
                              IsChecked="{Binding Settings.ShowNotifications, Mode=TwoWay}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================================================ STORAGE -->
        <TabItem Header="Storage">
            <ScrollViewer Padding="14,10,14,14">
                <StackPanel>
                    <TextBlock Text="Save" Style="{StaticResource SectionHeading}" Margin="0,4,0,8" />
                    <CheckBox Content="Text" IsChecked="{Binding Settings.StoreText, Mode=TwoWay}" />
                    <CheckBox Content="Images" IsChecked="{Binding Settings.StoreImages, Mode=TwoWay}" />
                    <CheckBox Content="Files" IsChecked="{Binding Settings.StoreFiles, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource SettingsHelp}"
                               Text="Turning a kind off stops it being recorded. Items already in the history are kept." />

                    <TextBlock Text="History" Style="{StaticResource SectionHeading}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Items to keep" Style="{StaticResource SettingsLabel}" />
                        <TextBox Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding Settings.Size, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sort by" Style="{StaticResource SettingsLabel}" />
                        <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding SortOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.SortBy, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Text="Database" Style="{StaticResource SectionHeading}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Current size" Style="{StaticResource SettingsLabel}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding StorageSize, Converter={StaticResource ByteSize}}" />
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                                       Style="{StaticResource SecondaryText}"
                                       Text="{Binding ItemCountText}" />
                            <Button Content="Compact" Margin="14,0,0,0" Style="{StaticResource DialogButton}"
                                    Click="OnCompact" />
                            <Button Content="Open folder" Margin="8,0,0,0" Style="{StaticResource DialogButton}"
                                    Click="OnOpenDataFolder" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ========================================================= APPEARANCE -->
        <TabItem Header="Appearance">
            <ScrollViewer Padding="14,10,14,14">
                <StackPanel>
                    <TextBlock Text="Popup" Style="{StaticResource SectionHeading}" Margin="0,4,0,8" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Open at" Style="{StaticResource SettingsLabel}" />
                        <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding PopupPositions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.PopupPosition, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="On screen" Style="{StaticResource SettingsLabel}" />
                        <ComboBox Grid.Column="1" Width="260" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Screens}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.PopupScreen, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Size" Style="{StaticResource SettingsLabel}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="80" Style="{StaticResource SettingsTextBox}"
                                     Text="{Binding Settings.WindowWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center" />
                            <TextBox Width="80" Style="{StaticResource SettingsTextBox}"
                                     Text="{Binding Settings.WindowHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="maximum" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Use the Windows 11 acrylic backdrop"
                              IsChecked="{Binding Settings.UseBackdrop, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource SettingsHelp}"
                               Text="Takes effect the next time the popup opens. Ignored on Windows 10, which has no system backdrop." />

                    <TextBlock Text="List" Style="{StaticResource SectionHeading}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pin items to" Style="{StaticResource SettingsLabel}" />
                        <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding PinPositions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.PinTo, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Highlight matches" Style="{StaticResource SettingsLabel}" />
                        <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding HighlightStyles}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.HighlightMatch, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Image row height" Style="{StaticResource SettingsLabel}" />
                        <TextBox Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding Settings.ImageMaxHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <CheckBox Content="Show the search field" IsChecked="{Binding Settings.ShowSearch, Mode=TwoWay}" />
                    <Grid Style="{StaticResource Row}" Margin="20,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Visible" Style="{StaticResource SettingsLabel}" />
                        <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                  IsEnabled="{Binding Settings.ShowSearch}"
                                  ItemsSource="{Binding SearchVisibilities}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.SearchVisibility, Mode=TwoWay}" />
                    </Grid>

                    <CheckBox Content="Show the title" IsChecked="{Binding Settings.ShowTitle, Mode=TwoWay}" />
                    <CheckBox Content="Show the footer" IsChecked="{Binding Settings.ShowFooter, Mode=TwoWay}" />
                    <CheckBox Content="Show the source application's icon"
                              IsChecked="{Binding Settings.ShowApplicationIcons, Mode=TwoWay}" />
                    <CheckBox Content="Show a swatch next to copied colours"
                              IsChecked="{Binding Settings.ShowHexColorSwatch, Mode=TwoWay}" />
                    <CheckBox Content="Show newlines and tabs as symbols"
                              IsChecked="{Binding Settings.ShowSpecialSymbols, Mode=TwoWay}" />

                    <TextBlock Text="Preview" Style="{StaticResource SectionHeading}" />
                    <CheckBox Content="Open the preview automatically"
                              IsChecked="{Binding Settings.OpenPreviewAutomatically, Mode=TwoWay}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Show it on the" Style="{StaticResource SettingsLabel}" />
                        <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding PreviewPlacements}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.PreviewPlacement, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="After" Style="{StaticResource SettingsLabel}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="90" Style="{StaticResource SettingsTextBox}"
                                     Text="{Binding Settings.PreviewDelay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="milliseconds" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Tray icon" Style="{StaticResource SectionHeading}" />
                    <CheckBox Content="Show Wincy in the notification area"
                              IsChecked="{Binding Settings.ShowInTray, Mode=TwoWay}" />
                    <CheckBox Content="Show the most recent copy in the tooltip"
                              IsChecked="{Binding Settings.ShowRecentCopyInTooltip, Mode=TwoWay}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Icon" Style="{StaticResource SettingsLabel}" />
                        <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding TrayIcons}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.TrayIcon, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- =============================================================== PINS -->
        <TabItem Header="Pins">
            <Grid Margin="14,10,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SettingsHelp}" Margin="0,0,0,10"
                           Text="Pinned items stay at the top of the list and keep a permanent letter shortcut. Choose a different letter below, or unpin an item to release it." />

                <ListBox Grid.Row="1" x:Name="PinsList" Style="{StaticResource SettingsListBox}"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Width="60" ItemsSource="{Binding AvailablePins}"
                                          SelectedItem="{Binding Pin, Mode=TwoWay}" />

                                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <Button Grid.Column="2" Content="Unpin" Style="{StaticResource DialogButton}"
                                        Click="OnUnpin" Tag="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource SecondaryText}"
                           Text="{Binding PinCountText}" />
            </Grid>
        </TabItem>

        <!-- ============================================================= IGNORE -->
        <TabItem Header="Ignore">
            <ScrollViewer Padding="14,10,14,14">
                <StackPanel>
                    <TextBlock Text="Applications" Style="{StaticResource SectionHeading}" Margin="0,4,0,8" />
                    <CheckBox Content="Ignore every application except the ones listed"
                              IsChecked="{Binding Settings.IgnoreAllAppsExceptListed, Mode=TwoWay}" />

                    <ListBox x:Name="AppsList" Height="120" Margin="0,8,0,0"
                             Style="{StaticResource SettingsListBox}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBox x:Name="AppEntry" Width="220" Style="{StaticResource SettingsTextBox}" />
                        <Button Content="Add" Margin="8,0,0,0" Style="{StaticResource DialogButton}"
                                Click="OnAddApp" />
                        <Button Content="Browse…" Margin="8,0,0,0" Style="{StaticResource DialogButton}"
                                Click="OnBrowseApp" />
                        <Button Content="Remove" Margin="8,0,0,0" Style="{StaticResource DialogButton}"
                                Click="OnRemoveApp" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SettingsHelp}"
                               Text="Executable names, such as keepass.exe. Copies made in these applications are never recorded." />

                    <TextBlock Text="Patterns" Style="{StaticResource SectionHeading}" />
                    <ListBox x:Name="RegexList" Height="100" Style="{StaticResource SettingsListBox}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBox x:Name="RegexEntry" Width="300" Style="{StaticResource SettingsTextBox}" />
                        <Button Content="Add" Margin="8,0,0,0" Style="{StaticResource DialogButton}"
                                Click="OnAddRegex" />
                        <Button Content="Remove" Margin="8,0,0,0" Style="{StaticResource DialogButton}"
                                Click="OnRemoveRegex" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SettingsHelp}"
                               Text="Regular expressions. Any copied text that matches is discarded — useful for card numbers or tokens." />

                    <TextBlock Text="Clipboard formats" Style="{StaticResource SectionHeading}" />
                    <ListBox x:Name="FormatsList" Height="100" Style="{StaticResource SettingsListBox}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBox x:Name="FormatEntry" Width="300" Style="{StaticResource SettingsTextBox}" />
                        <Button Content="Add" Margin="8,0,0,0" Style="{StaticResource DialogButton}"
                                Click="OnAddFormat" />
                        <Button Content="Remove" Margin="8,0,0,0" Style="{StaticResource DialogButton}"
                                Click="OnRemoveFormat" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SettingsHelp}"
                               Text="Wincy always honours the standard privacy formats that password managers set. Add more here to ignore an application that does not set them." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- =========================================================== ADVANCED -->
        <TabItem Header="Advanced">
            <ScrollViewer Padding="14,10,14,14">
                <StackPanel>
                    <TextBlock Text="Recording" Style="{StaticResource SectionHeading}" Margin="0,4,0,8" />
                    <CheckBox Content="Pause recording" IsChecked="{Binding Settings.IgnoreEvents, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource SettingsHelp}"
                               Text="While paused, nothing new is added to the history. You can also Alt+click the tray icon to toggle this, or Alt+Shift+click it to skip only the next copy." />

                    <Grid Style="{StaticResource Row}" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Settle delay" Style="{StaticResource SettingsLabel}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="90" Style="{StaticResource SettingsTextBox}"
                                     Text="{Binding Settings.ClipboardDebounceMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="milliseconds" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource SettingsHelp}" Margin="180,0,0,0"
                               Text="How long Wincy waits after the clipboard changes before reading it. Some applications publish their formats in several passes; raise this if rich copies arrive as plain text." />

                    <TextBlock Text="Clearing" Style="{StaticResource SectionHeading}" />
                    <CheckBox Content="Clear the history when Wincy quits"
                              IsChecked="{Binding Settings.ClearOnQuit, Mode=TwoWay}" />
                    <CheckBox Content="Also empty the system clipboard when clearing"
                              IsChecked="{Binding Settings.ClearSystemClipboard, Mode=TwoWay}" />
                    <CheckBox Content="Don't ask for confirmation before clearing"
                              IsChecked="{Binding Settings.SuppressClearAlert, Mode=TwoWay}" />

                    <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeading}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open the log" Style="{StaticResource DialogButton}" Click="OnOpenLog" />
                        <Button Content="Open the data folder" Margin="8,0,0,0"
                                Style="{StaticResource DialogButton}" Click="OnOpenDataFolder" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
