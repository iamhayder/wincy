<Window x:Class="Wincy.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Wincy.Views.Controls"
        Title="Wincy"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontSize="13"
        Width="450"
        Height="400">

    <Window.Resources>

        <!-- =================================================== history row === -->

        <DataTemplate x:Key="ClipRowTemplate">
            <Border x:Name="RowRoot"
                    MinHeight="{DynamicResource ItemHeight}"
                    CornerRadius="{DynamicResource ItemCornerRadius}"
                    Background="Transparent"
                    ToolTip="{Binding Tooltip}"
                    MouseMove="OnRowHover"
                    SnapsToDevicePixels="True">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ActivateCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>

                <Grid Margin="4,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Source application icon -->
                    <Image Grid.Column="0" Width="15" Height="15" Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Source="{Binding ApplicationIcon}"
                           Visibility="{Binding ApplicationIcon, Converter={StaticResource NullToVisibility}}" />

                    <!-- Colour swatch for copied hex/rgb values -->
                    <Border Grid.Column="1" Width="13" Height="13" CornerRadius="3" Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                            Background="{Binding Swatch, Converter={StaticResource ColorToBrush}}"
                            Visibility="{Binding HasSwatch, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Image thumbnail, or the title -->
                    <Image Grid.Column="2" HorizontalAlignment="Left" Margin="0,3"
                           Source="{Binding Thumbnail}"
                           Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}" />

                    <controls:HighlightTextBlock x:Name="Title" Grid.Column="2"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding Title}"
                                                 Ranges="{Binding HighlightRanges}"
                                                 HighlightStyle="{Binding HighlightStyle}"
                                                 HighlightBrush="{DynamicResource HighlightBrush}"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 Visibility="{Binding HasImage,
                                                     Converter={StaticResource BoolToVisibilityInverted}}" />

                    <!-- Position within a multi-selection -->
                    <Border Grid.Column="3" CornerRadius="8" Margin="6,0,0,0" Padding="6,1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BadgeBackgroundBrush}"
                            Visibility="{Binding MultiSelectionBadge, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding MultiSelectionBadge}" FontSize="10.5" />
                    </Border>

                    <!-- Shortcut badge for the modifiers currently held -->
                    <Border x:Name="Shortcut" Grid.Column="4" Style="{StaticResource ShortcutBadge}" Margin="6,0,0,0"
                            Visibility="{Binding HasVisibleShortcut, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding VisibleShortcut.Description}"
                                   Style="{StaticResource ShortcutBadgeText}" />
                    </Border>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="RowRoot" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                    <Setter TargetName="Shortcut" Property="Background" Value="#33FFFFFF" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ==================================================== footer row === -->

        <DataTemplate x:Key="FooterRowTemplate">
            <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Border x:Name="FooterRoot"
                        MinHeight="{DynamicResource ItemHeight}"
                        CornerRadius="{DynamicResource ItemCornerRadius}"
                        Background="Transparent"
                        ToolTip="{Binding Tooltip}"
                        MouseMove="OnFooterRowHover"
                        SnapsToDevicePixels="True">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.ActivateFooterCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}" />
                    </Border.InputBindings>

                    <Grid Margin="10,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="FooterTitle" Text="{Binding Title}" VerticalAlignment="Center" />

                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Shortcuts}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ShortcutBadge}" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource ShortcutBadgeText}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Inline confirmation, shown in place of the row -->
                <Border CornerRadius="{DynamicResource ItemCornerRadius}"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                        Padding="10" Margin="0,2"
                        Visibility="{Binding ShowConfirmation, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ConfirmationMessage}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ConfirmationDetail}" TextWrapping="Wrap"
                                   Style="{StaticResource SettingsHelp}" />
                        <CheckBox Content="Don't ask again" Margin="0,8,0,0"
                                  IsChecked="{Binding DataContext.SuppressClearAlert, Mode=TwoWay,
                                      RelativeSource={RelativeSource AncestorType=Window}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Cancel" Style="{StaticResource DialogButton}" Margin="0,0,8,0"
                                    Command="{Binding DataContext.CancelConfirmationCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Clear" Style="{StaticResource PrimaryDialogButton}"
                                    Command="{Binding DataContext.ConfirmCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="FooterRoot" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="FooterTitle" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- List container: no default selection chrome, we draw our own -->
        <Style x:Key="PlainListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ContentColumn" Width="*" />
            <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
            <ColumnDefinition x:Name="PreviewColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ================================================ main column ==== -->

        <Grid Grid.Column="0" Margin="5,0,5,0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="Auto" />
                <RowDefinition x:Name="StackRow" Height="Auto" />
                <RowDefinition x:Name="TopPinsRow" Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="BottomPinsRow" Height="Auto" />
                <RowDefinition x:Name="FooterRow" Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title, search field, preview toggle -->
            <Grid x:Name="Header" Grid.Row="0" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="AppTitle" Text="Wincy" Margin="5,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <Border Grid.Column="1" Height="24" CornerRadius="{DynamicResource ItemCornerRadius}"
                        Background="{DynamicResource FieldBackgroundBrush}">
                    <Grid Margin="7,0,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Magnifier -->
                        <Path Grid.Column="0" Width="11" Height="11" Margin="0,0,6,0" Stretch="Uniform"
                              VerticalAlignment="Center" Opacity="0.65"
                              Fill="{DynamicResource TextBrush}"
                              Data="M 9.5,8 A 4.5,4.5 0 1 0 9.5,-1 A 4.5,4.5 0 1 0 9.5,8 Z
                                    M 9.5,6.5 A 3,3 0 1 1 9.5,0.5 A 3,3 0 1 1 9.5,6.5 Z
                                    M 12.2,6.4 L 13.3,5.3 L 17,9 L 15.9,10.1 Z" />

                        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBox}" />

                        <TextBlock Grid.Column="1" Text="type to search…" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Opacity="0.55"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Visibility="{Binding Text, ElementName=SearchBox,
                                       Converter={StaticResource NullToVisibilityInverted}}" />

                        <Button Grid.Column="2" x:Name="ClearSearchButton" Style="{StaticResource FlatButton}"
                                Padding="2" ToolTip="Clear search"
                                Visibility="{Binding Text, ElementName=SearchBox,
                                    Converter={StaticResource NullToVisibility}}">
                            <Path Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource SecondaryTextBrush}"
                                  Data="M 2,3.1 L 3.1,2 L 8,6.9 L 12.9,2 L 14,3.1 L 9.1,8 L 14,12.9
                                        L 12.9,14 L 8,9.1 L 3.1,14 L 2,12.9 L 6.9,8 Z" />
                        </Button>
                    </Grid>
                </Border>

                <Button Grid.Column="2" x:Name="PreviewToggleButton" Style="{StaticResource FlatButton}"
                        Margin="4,0,0,0" Padding="5,3" ToolTip="Toggle preview (Alt+Space)">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                          Data="M 2,3 L 20,3 A 1,1 0 0 1 21,4 L 21,18 A 1,1 0 0 1 20,19 L 2,19
                                A 1,1 0 0 1 1,18 L 1,4 A 1,1 0 0 1 2,3 Z
                                M 3,5 L 3,17 L 13,17 L 13,5 Z" />
                </Button>
            </Grid>

            <!-- Paste stack banner -->
            <Border x:Name="PasteStackBanner" Grid.Row="1" Margin="0,6,0,0" Padding="10,5"
                    CornerRadius="{DynamicResource ItemCornerRadius}"
                    Background="{DynamicResource FieldBackgroundBrush}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PasteStackLabel" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="StopPasteStackButton" Content="Stop"
                            Style="{StaticResource FlatButton}" ToolTip="Stop the paste stack" />
                </Grid>
            </Border>

            <!-- Pinned items, above the history -->
            <StackPanel x:Name="TopPins" Grid.Row="2" Visibility="Collapsed">
                <ItemsControl x:Name="TopPinsList" Margin="0,6,0,0"
                              ItemTemplate="{StaticResource ClipRowTemplate}" />
                <Border Style="{StaticResource RowSeparator}" x:Name="TopPinsSeparator" />
            </StackPanel>

            <!-- History -->
            <ListBox x:Name="HistoryList" Grid.Row="3"
                     Background="Transparent" BorderThickness="0" Padding="0" Margin="0,3,0,3"
                     Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ItemContainerStyle="{StaticResource PlainListItem}"
                     ItemTemplate="{StaticResource ClipRowTemplate}" />

            <!-- Pinned items, below the history -->
            <StackPanel x:Name="BottomPins" Grid.Row="4" Visibility="Collapsed">
                <Border Style="{StaticResource RowSeparator}" />
                <ItemsControl x:Name="BottomPinsList" ItemTemplate="{StaticResource ClipRowTemplate}" />
            </StackPanel>

            <!-- Footer -->
            <StackPanel x:Name="Footer" Grid.Row="5" Margin="0,0,0,5">
                <Border Style="{StaticResource RowSeparator}" />
                <ItemsControl x:Name="FooterList" ItemTemplate="{StaticResource FooterRowTemplate}" />
            </StackPanel>
        </Grid>

        <!-- ==================================================== splitter ==== -->

        <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="4"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" Visibility="Collapsed" />

        <!-- ===================================================== preview ==== -->

        <Border x:Name="PreviewPane" Grid.Column="2" Visibility="Collapsed"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1,0,0,0"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Style="{StaticResource SlimScrollViewer}">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Visibility="Collapsed" />
                        <TextBlock x:Name="PreviewText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}" />
                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Border Style="{StaticResource RowSeparator}" Margin="0,0,0,8" />
                    <TextBlock x:Name="PreviewApplication" Style="{StaticResource SecondaryText}" FontSize="11.5" />
                    <TextBlock x:Name="PreviewFirstCopied" Style="{StaticResource SecondaryText}" FontSize="11.5" />
                    <TextBlock x:Name="PreviewLastCopied" Style="{StaticResource SecondaryText}" FontSize="11.5" />
                    <TextBlock x:Name="PreviewCopyCount" Style="{StaticResource SecondaryText}" FontSize="11.5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
