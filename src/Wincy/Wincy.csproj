<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 is the current LTS. Nothing here needs >= net9 APIs, so you can
         drop this to net8.0-windows if that is the SDK you have installed. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Wincy</AssemblyName>
    <RootNamespace>Wincy</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Wincy.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0</Version>
    <Product>Wincy</Product>
    <Company>Wincy</Company>
    <Description>Clipboard history for Windows</Description>
    <Copyright>MIT</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Shapes `dotnet publish` only; it has no effect on build or test. The runtime
         identifier is deliberately NOT set here: pinning a RID to the Release
         configuration makes `restore` (which runs as Debug) and `build -c Release`
         resolve different assets, and the build then fails with NETSDK1047. Pass the
         RID and self-contained flags on the publish command line instead. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 9.0.0 resolved SQLitePCLRaw 2.1.10, which carries GHSA-2m69-gcr7-jv3q.
         This line pulls 2.1.12. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF implicitly imports System.Windows.Shapes, whose Path type collides with
         System.IO.Path. The XAML side refers to Shapes.Path by tag name, so dropping
         the C# import costs nothing and keeps file-path code unambiguous. -->
    <Using Remove="System.Windows.Shapes" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Wincy.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests reach internals such as ClipContent's lazy-load plumbing. -->
    <InternalsVisibleTo Include="Wincy.Tests" />
  </ItemGroup>

</Project>
