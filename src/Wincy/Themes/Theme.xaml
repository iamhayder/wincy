<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Light values are the defaults. App.ApplyTheme() overwrites every colour key at
        runtime from the system theme and accent colour, so nothing here is baked in —
        these exist so the designer has something to render.
    -->

    <Color x:Key="WindowBackgroundColor">#F3F3F3</Color>
    <Color x:Key="TextColor">#1A1A1A</Color>
    <Color x:Key="SecondaryTextColor">#6A6A6A</Color>
    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="SeparatorColor">#22000000</Color>
    <Color x:Key="FieldBackgroundColor">#16000000</Color>
    <Color x:Key="HoverBackgroundColor">#12000000</Color>
    <Color x:Key="BadgeBackgroundColor">#22000000</Color>
    <Color x:Key="HighlightColor">#FFF07A</Color>
    <Color x:Key="FieldBorderColor">#26000000</Color>
    <Color x:Key="KeycapBackgroundColor">#0E000000</Color>
    <Color x:Key="KeycapBorderColor">#28000000</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource AccentTextColor}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{DynamicResource SeparatorColor}" />
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="{DynamicResource FieldBackgroundColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{DynamicResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="{DynamicResource BadgeBackgroundColor}" />
    <SolidColorBrush x:Key="HighlightBrush" Color="{DynamicResource HighlightColor}" />
    <SolidColorBrush x:Key="FieldBorderBrush" Color="{DynamicResource FieldBorderColor}" />
    <SolidColorBrush x:Key="KeycapBackgroundBrush" Color="{DynamicResource KeycapBackgroundColor}" />
    <SolidColorBrush x:Key="KeycapBorderBrush" Color="{DynamicResource KeycapBorderColor}" />

    <!-- Maccy's popup metrics, in device-independent pixels. -->
    <sys:Double x:Key="ItemHeight">24</sys:Double>
    <CornerRadius x:Key="ItemCornerRadius">5</CornerRadius>
    <Thickness x:Key="PopupPadding">5,0,5,0</Thickness>

</ResourceDictionary>
