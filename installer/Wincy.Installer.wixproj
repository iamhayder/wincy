<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <OutputName>Wincy</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- MSI product versions are three-part; a fourth would be ignored for upgrade
         detection and quietly break version-to-version upgrades. -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <!-- Path to the published single-file executable, supplied by the build command. -->
    <WincyExe Condition="'$(WincyExe)' == ''">$(MSBuildThisFileDirectory)..\publish\Wincy.exe</WincyExe>
    <DefineConstants>WincyExe=$(WincyExe)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- util: provides CloseApplication, so an upgrade or uninstall can shut a running
         copy down instead of failing on a locked file.
         ui:   provides the install wizard. -->
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

</Project>
