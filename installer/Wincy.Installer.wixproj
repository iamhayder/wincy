<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <OutputName>Wincy</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>

    <!--
      ICE61 objects that the upgrade range covers the current version as well as older
      ones. That is exactly what AllowSameVersionUpgrades asks for, and it is wanted
      here: WiX mints a fresh ProductCode on every build, so without it, installing a
      rebuilt 1.0.0 over an existing 1.0.0 would leave two entries in Add or Remove
      Programs instead of replacing the first.
    -->
    <SuppressIces>ICE61</SuppressIces>
    <!-- MSI product versions are three-part; a fourth would be ignored for upgrade
         detection and quietly break version-to-version upgrades. -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <!-- Path to the published single-file executable, supplied by the build command. -->
    <WincyExe Condition="'$(WincyExe)' == ''">$(MSBuildThisFileDirectory)..\publish\Wincy.exe</WincyExe>
    <LicenseRtf>$(MSBuildThisFileDirectory)License.rtf</LicenseRtf>

    <!--
      MSBuild properties are not visible to the WiX preprocessor. Anything Package.wxs
      refers to as $(Name) has to be handed over explicitly here, which is also why the
      .wxs cannot use MSBuild-only values such as $(MSBuildThisFileDirectory).
    -->
    <DefineConstants>WincyExe=$(WincyExe);Version=$(Version);LicenseRtf=$(LicenseRtf)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- util: provides CloseApplication, so an upgrade or uninstall can shut a running
         copy down instead of failing on a locked file.
         ui:   provides the install wizard. -->
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

</Project>
